{
  "name": "ai-manga-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "release:prepare": "npm run sync:feishu:monster && npm run build",
    "cf:dev": "npx wrangler pages dev dist",
    "cf:project:create": "npx wrangler pages project create monster-production-hub-951017 --production-branch claude/add-chart-components-Cqdu3",
    "cf:deploy": "npm run build && npx wrangler pages deploy dist --project-name monster-production-hub-951017 --branch claude/add-chart-components-Cqdu3",
    "import:monster": "python scripts/import_monster_project_dashboard.py",
    "import:monster:ep1": "python scripts/import_monster_ep01.py",
    "import:hucun": "python scripts/import_hucun_dashboard.py",
    "sync:feishu:monster": "node scripts/feishu-sync/export-monster-scene-runtime.js",
    "sync:feishu": "node scripts/feishu-sync/index.js --config scripts/feishu-sync/config.local.json",
    "sync:feishu:validate": "node scripts/feishu-sync/index.js --validate-config --config scripts/feishu-sync/config.example.json",
    "sync:feishu:tables": "node scripts/feishu-sync/index.js --list-tables --config scripts/feishu-sync/config.local.json"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^5.4.2"
  }
}
